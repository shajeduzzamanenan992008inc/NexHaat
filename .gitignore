# NexHaat repository ignore policy.
# Keep generated state, local configuration, credentials and build output out of Git.
# Source files, lockfiles, migrations, documentation and approved screenshots stay trackable.

# Secrets and local configuration
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.publishsettings
*-firebase-adminsdk-*.json
firebase-service-account*.json
service-account*.json
azure-credentials*.json
.secrets/
.azure/
.firebase/
.aws/
**/local.properties

# Python and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv*/
venv/
ENV/
env/
antenv/
.pytest_cache/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
coverage.xml
pytest-report.xml
pip-wheel-metadata/
.python-version
build/
dist/
*.egg-info/
*.whl
wheels/

# Node, React, Vite, TypeScript and Express
node_modules/
**/node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.vite/
**/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
playwright-report/
test-results/
.nyc_output/
.next/
.nuxt/

# Android / Gradle / Kotlin
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
.cxx/
.externalNativeBuild/
**/build/
*.apk
*.aab
*.dex
*.hprof
*.jfr
captures/

# Runtime databases, backups, imports, quarantine and generated uploads
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.db-journal
backups/
instance/*.sqlite3
instance/*.sqlite
instance/*.db
instance/*.db-*
instance/*.log
instance/datasets/
instance/quarantine/
uploads/*
!uploads/.gitkeep
app/static/profile-image-test-*/
app/static/uploads/profiles/*
!app/static/uploads/profiles/.gitkeep
app/static/uploads/branding/*
!app/static/uploads/branding/.gitkeep
app/static/uploads/products/*
!app/static/uploads/products/.gitkeep
app/static/uploads/delivery/*
!app/static/uploads/delivery/.gitkeep

# Logs, diagnostics, temporary files and deployment archives
*.log
logs/
azure-logs/
startup.log
oryx-manifest.toml
tmp_*
tests/tmp_*
*.tmp
*.temp
*.bak
*.swp
*~
*.zip
*.tar
*.tar.gz
*.tgz
nexhaat-deploy.zip
staging/

# IDE and operating system files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local automation and browser-test state
.playwright-mcp/
.playwright/
/artifacts/
# Android System Images & Emulators
android/system-images*/
android/build-debug-nohup.out
android/gradlew-build.pid

# Backups & Reports
node_modules.backup.before-ci/
.temp_recovery/
android/system-images*/
node_modules.backup.before-ci/
.temp_recovery/

# Do not blanket-ignore image formats: approved screenshots, diagrams and brand
# assets may be committed under docs/assets/ or another intentional source path.
