# NexHaat — Git attributes and cross-platform text/binary policy.
# Canonical text files use LF in the repository across Windows, Linux and macOS.
* text=auto eol=lf

# Explicit source, configuration and documentation formats.
*.md       text eol=lf
*.txt      text eol=lf
*.rst      text eol=lf
*.adoc     text eol=lf
*.py       text eol=lf
*.pyi      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.conf     text eol=lf
*.properties text eol=lf
*.xml      text eol=lf
*.html     text eol=lf
*.htm      text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.sass     text eol=lf
*.less     text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf
*.bash     text eol=lf
*.ps1      text eol=lf
*.gradle   text eol=lf
*.kts      text eol=lf
*.kt       text eol=lf
*.java     text eol=lf
*.po       text eol=lf
*.pot      text eol=lf
*.patch    text eol=lf
*.diff     text eol=lf
*.svg      text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows command scripts use CRLF in working trees.
*.bat text eol=crlf
*.cmd text eol=crlf

# Images and other binary design assets.
*.png      binary -eol
*.jpg      binary -eol
*.jpeg     binary -eol
*.jpe      binary -eol
*.gif      binary -eol
*.webp     binary -eol
*.avif     binary -eol
*.bmp      binary -eol
*.tif      binary -eol
*.tiff     binary -eol
*.ico      binary -eol
*.icns     binary -eol
*.heic     binary -eol
*.heif     binary -eol
*.ttf      binary -eol
*.otf      binary -eol
*.woff     binary -eol
*.woff2    binary -eol
*.eot      binary -eol
*.psd      binary -eol
*.ai       binary -eol
*.sketch   binary -eol

# Audio and video.
*.mp3      binary -eol
*.m4a      binary -eol
*.aac      binary -eol
*.wav      binary -eol
*.ogg      binary -eol
*.flac     binary -eol
*.mp4      binary -eol
*.m4v      binary -eol
*.mov      binary -eol
*.avi      binary -eol
*.mkv      binary -eol
*.webm     binary -eol

# Documents and compressed archives.
*.pdf      binary -eol
*.zip      binary -eol
*.7z       binary -eol
*.rar      binary -eol
*.gz       binary -eol
*.tgz      binary -eol
*.tar      binary -eol
*.tar.gz   binary -eol
*.bz2      binary -eol
*.xz       binary -eol
*.zst      binary -eol

# Compiled/runtime objects and database files.
*.apk      binary -eol
*.aab      binary -eol
*.dex      binary -eol
*.class    binary -eol
*.jar      binary -eol
*.war      binary -eol
*.ear      binary -eol
*.exe      binary -eol
