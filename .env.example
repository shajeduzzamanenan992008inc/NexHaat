# NexHaat local environment template (dotenv format).
# Copy to .env for local development. Never commit .env or put real secrets in this file.
# Production MUST use a random SECRET_KEY, HTTPS, managed PostgreSQL with TLS, and host-level secrets.
# Generate a local secret with: python -c "import secrets; print(secrets.token_hex(32))"
# AI/provider integrations are safely disabled until you configure real endpoints, models, and credentials.

# --- Application / local development ---
APP_ENV=development
FLASK_DEBUG=0
FLASK_TESTING=0
SECRET_KEY=dev-only-change-me
DATABASE_URL=sqlite:///instance/food_ordering.sqlite3
PUBLIC_BASE_URL=http://127.0.0.1:5000
SESSION_COOKIE_SECURE=0
APP_TIMING_ENABLED=0

# --- Database and request limits ---
MAX_DATABASE_BYTES=419430400
MAX_CONTENT_LENGTH=4194304
MAX_IMAGE_UPLOAD_BYTES=2097152
MAX_RASTER_IMAGE_PIXELS=20000000
MAX_SEARCH_LENGTH=100
CATALOG_PAGE_SIZE=48

# --- Authentication, admin, email ---
ADMIN_EMAIL=
BREVO_API_KEY=
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT=15
MAX_EMAIL_ATTEMPTS=5
SUPPORT_EMAIL=

# --- SSLCOMMERZ payments ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=1
SSLCOMMERZ_TIMEOUT=12
PAYMENT_SESSION_MINUTES=15

# --- Telegram customer/security bots ---
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_CUSTOMER_WEBHOOK_SECRET=
TELEGRAM_SECURITY_BOT_TOKEN=
TELEGRAM_SECURITY_WEBHOOK_SECRET=
TELEGRAM_SECURITY_ADMIN_IDS=
TELEGRAM_SECURITY_ADMIN_USER_MAP=
TELEGRAM_SUPPORT_URL=
TELEGRAM_RATE_LIMIT_PER_MINUTE=30
TELEGRAM_SECURITY_RATE_LIMIT_PER_MINUTE=10
TELEGRAM_API_TIMEOUT=10

# --- Catalog uploads, antivirus, object storage ---
CATALOG_VIRUS_SCANNER=clamdscan
CATALOG_SCAN_TIMEOUT=20
CATALOG_QUARANTINE_FOLDER=instance/quarantine/catalog
CATALOG_MEDIA_BUCKET=
CATALOG_MEDIA_REGION=us-east-1
CATALOG_MEDIA_ENDPOINT_URL=
CATALOG_MEDIA_PUBLIC_BASE_URL=
CATALOG_MEDIA_KEY_PREFIX=products
MAX_CATALOG_IMAGE_BYTES=3145728
MAX_CATALOG_IMAGE_PIXELS=40000000
MAX_CATALOG_QUARANTINE_BYTES=104857600
CATALOG_QUARANTINE_RETENTION_HOURS=24
INVOICE_FONT_PATH=

# --- Hybrid AI - primary provider ---
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_API_INPUT_USD_PER_MILLION=0
AI_API_OUTPUT_USD_PER_MILLION=0
AI_API_IS_FREE=false
AI_TIMEOUT=15
AI_MAX_TOKENS=1024
AI_RATE_LIMIT=60
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_MAX_TOOL_CALLS=5
AI_MAX_CONTEXT_SIZE=12000

# --- Hybrid AI - private local inference / embeddings / voice / search ---
AI_LOCAL_ENABLED=true
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AI_EMBEDDING_API_KEY=
AI_ASR_BASE_URL=
AI_ASR_MODEL=
AI_TTS_BASE_URL=
AI_TTS_MODEL=
AI_TTS_VOICE=default
AI_SEARCH_BASE_URL=

# --- Hybrid AI - external fallback and budget controls ---
AI_EXTERNAL_ENABLED=false
AI_EXTERNAL_LOCAL_NOTICE_MODE=false
AI_EXTERNAL_MONTHLY_BUDGET_USD=0
AI_EXTERNAL_MAX_TOKENS=1024
AI_BUILDER_SANDBOX_IMAGE=
AI_BUILDER_TEST_TIMEOUT_SECONDS=60

# --- Specialist providers (credentials are always blank in this template) ---
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_INPUT_USD_PER_MILLION=0
AI_OPENAI_OUTPUT_USD_PER_MILLION=0
AI_OPENAI_AGENT_NAME=Astra
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_ANTHROPIC_INPUT_USD_PER_MILLION=0
AI_ANTHROPIC_OUTPUT_USD_PER_MILLION=0
AI_ANTHROPIC_AGENT_NAME=Luna
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_GEMINI_INPUT_USD_PER_MILLION=0
AI_GEMINI_OUTPUT_USD_PER_MILLION=0
AI_GEMINI_AGENT_NAME=Sol
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_INPUT_USD_PER_MILLION=0
AI_DEEPSEEK_OUTPUT_USD_PER_MILLION=0
AI_DEEPSEEK_AGENT_NAME=Forge

# Production notes:
# - Set APP_ENV=production and SESSION_COOKIE_SECURE=1 in the host configuration.
# - Never deploy the development SECRET_KEY value.
# - For direct hosted API primary: set AI_ENABLED=1 and AI_LOCAL_ENABLED=0; for local-first use, configure the local URL/model instead.
# - Do not turn on AI_EXTERNAL_ENABLED until specialist credentials, matching current pricing, user consent, notice delivery, and a positive budget cap are configured.
# - Run: flask --app run.py db upgrade; then flask --app run.py ensure-admin.
# - Before accepting public traffic, run: flask --app run.py production-check.
