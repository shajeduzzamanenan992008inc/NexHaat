FLASK_DEBUG=0
FLASK_TESTING=0
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///instance/food_ordering.sqlite3
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Payment Gateway (SSLCommerz)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=1
SSLCOMMERZ_TIMEOUT=12
PAYMENT_SESSION_MINUTES=15

# Limits & Uploads
MAX_DATABASE_BYTES=419430400
MAX_CONTENT_LENGTH=4194304
MAX_IMAGE_UPLOAD_BYTES=2097152
MAX_RASTER_IMAGE_PIXELS=20000000
MAX_SEARCH_LENGTH=100
CATALOG_PAGE_SIZE=48
APP_TIMING_ENABLED=0
SESSION_COOKIE_SECURE=0

# Email (Brevo / SMTP)
BREVO_API_KEY=
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT=15
MAX_EMAIL_ATTEMPTS=5
ADMIN_EMAIL=
SUPPORT_EMAIL=

# Telegram Bots
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_CUSTOMER_WEBHOOK_SECRET=
TELEGRAM_SECURITY_BOT_TOKEN=
TELEGRAM_SECURITY_WEBHOOK_SECRET=
TELEGRAM_SECURITY_ADMIN_IDS=
TELEGRAM_SUPPORT_URL=
TELEGRAM_RATE_LIMIT_PER_MINUTE=30
TELEGRAM_API_TIMEOUT=10

# Catalog & Security
INVOICE_FONT_PATH=
CATALOG_VIRUS_SCANNER=clamdscan
CATALOG_SCAN_TIMEOUT=20
CATALOG_QUARANTINE_FOLDER=instance/quarantine/catalog
CATALOG_MEDIA_BUCKET=
CATALOG_MEDIA_REGION=us-east-1
CATALOG_MEDIA_ENDPOINT_URL=
CATALOG_MEDIA_PUBLIC_BASE_URL=
CATALOG_MEDIA_KEY_PREFIX=products
MAX_CATALOG_IMAGE_BYTES=3145728
MAX_CATALOG_IMAGE_PIXELS=40000000
MAX_CATALOG_QUARANTINE_BYTES=104857600
CATALOG_QUARANTINE_RETENTION_HOURS=24

# AI Assistant Settings
AI_ENABLED=false
AI_PROVIDER=openai_compatible
# Set AI_ENABLED=true and a private AI_API_KEY to switch on the AI assistants.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT=15
AI_MAX_TOKENS=1024
AI_RATE_LIMIT=60
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_MAX_TOOL_CALLS=5
AI_MAX_CONTEXT_SIZE=12000

# SMS OTP (Bangladesh) - Provider Independent (disabled by default)
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_TIMEOUT=10
# Optional fallback provider
SMS_FALLBACK_PROVIDER=
SMS_FALLBACK_API_KEY=
SMS_MAX_ATTEMPTS=3