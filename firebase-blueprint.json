{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document in NexHaat marketplace",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["customer", "seller", "rider", "admin"] },
        "isPrime": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "name", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order in NexHaat",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "orderNumber", "userId", "totalAmount", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer review on a product",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles with authentication mapping"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Stores customer marketplace orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Stores product customer reviews"
    }
  }
}
