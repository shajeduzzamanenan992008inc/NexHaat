<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only override: developers run the Flask API on arbitrary LAN addresses,
    so cleartext stays permitted for debug builds. Release builds keep the strict
    configuration in src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
