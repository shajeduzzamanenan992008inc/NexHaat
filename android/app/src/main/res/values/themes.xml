<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexHaat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/nexhaat_blue</item>
        <item name="android:statusBarColor">@color/nexhaat_page</item>
        <item name="android:navigationBarColor">@color/nexhaat_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/nexhaat_page</item>
    </style>

    <style name="Theme.NexHaat.Starting" parent="Theme.NexHaat">
        <item name="android:windowBackground">@drawable/nexhaat_launch_screen</item>
    </style>
</resources>
